# by F.C.
#
# Use flags for custom hardware (see also /etc/portage/make.conf/00-devices.conf).


# ---- Settings shared with my desktop (CPU Ryzen 5900X + GPU Radeon RX 6900 XT) ----

# Use HIP only for AMD video cards.
dev-util/hip                    -video_cards_nvidia

# Install the NVIDIA dynamic boost daemon. This is required to boost the GPU
# power on some laptops, based on power profile and usage (without this daemon
# the GPU will be capped to the minimum power used for the power-save profile).
x11-drivers/nvidia-drivers      powerd


# ================================================================================
#  AI BACKEND SETTINGS FOR MY LAPTOP (CPU Ryzen 8940HX + GPU RTX 5070 Mobile)
# ================================================================================

# --------------------------------------------------------------------------------
#   Use CUDA for ALL packages (faster than Vulkan)
# --------------------------------------------------------------------------------
#   Large AI models can easily exceed the physical 8 GB of VRAM on the RTX 5070.
#   CUDA is mandatory on this hardware because its proprietary driver is roughly
#   3x faster than Vulkan in pure tensor computations. Furthermore, CUDA features
#   advanced virtual memory management, handling tight memory overhead gracefully
#   without throwing sudden device allocation crashes. To guarantee absolute
#   stability with heavy pipelines, text processing and secondary decoding
#   stages should be partially offloaded to the powerful 16-core Ryzen CPU.

# LLAMA.CPP
sci-misc/llama-cpp              cuda -vulkan

# OLLAMA
sci-ml/ggml                     cuda -vulkan
acct-user/ollama                cuda          # Required to use sci-ml/ggml with CUDA.

# PYTORCH & C.
dev-python/cupy                 cuda
sci-misc/stable-diffusion-cpp   cuda -vulkan
sci-ml/caffe2                   cuda          # Pytorch < 2.13 only.
sci-ml/pytorch                  cuda          # Pytorch 2.13 and above.
sci-ml/torchvision              cuda          # See /etc/portage/package.env/00-usegcc14.env
