# by F.C.
#
# These packages, with the 'cuda' use flag enabled,
# need gcc-14 (they fail to build with default gcc).
#
# Note: settings in /etc/portage/package.env/* are applied
# only when portage is actually processing the ebuild using
# bash, and that isn't done when using 'emerge --info'.

sci-ml/torchvision              usegcc14.conf
